{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-engine.invalid/mcp/tools-v1.json",
  "title": "Context Engine MCP tools",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tools"],
  "properties": {
    "version": { "const": "1" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "inputSchema"],
        "properties": {
          "name": {
            "enum": [
              "list_context_spaces",
              "query_context",
              "get_evidence",
              "explain_query",
              "ingest_context",
              "enrich_context",
              "delete_context_record"
            ]
          },
          "description": { "type": "string", "minLength": 1 },
          "inputSchema": { "type": "object" }
        }
      }
    }
  }
}
