# M0 live-provider profile. Copy values into your shell; do not commit secrets.
TELEMETRY_DISABLED=1
COGNEE_LOG_FILE=false
CACHING=false
ENABLE_BACKEND_ACCESS_CONTROL=true
REQUIRE_AUTHENTICATION=true
ACCEPT_LOCAL_FILE_PATH=false
ALLOW_HTTP_REQUESTS=false
ALLOW_CYPHER_QUERY=false

DB_PROVIDER=sqlite
GRAPH_DATABASE_PROVIDER=kuzu
GRAPH_DATASET_DATABASE_HANDLER=kuzu
VECTOR_DB_PROVIDER=lancedb
VECTOR_DATASET_DATABASE_HANDLER=lancedb

# Configure both model paths explicitly to prevent fallback to another provider.
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5-mini
LLM_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=

CONTEXT_ENGINE_RUN_LIVE_COGNEE=1
