# M2 local control-plane profile with static authentication. Copy to engine/.env.
CONTEXT_ENGINE_DB_PATH=.context-engine/control.db
CONTEXT_ENGINE_MIGRATIONS_PATH=migrations
CONTEXT_ENGINE_LOG_LEVEL=INFO
CONTEXT_ENGINE_WORKER_POLL_SECONDS=1
CONTEXT_ENGINE_WORKER_LEASE_SECONDS=30
CONTEXT_ENGINE_WORKER_MAX_ATTEMPTS=5
CONTEXT_ENGINE_AUTH_MODE=static
CONTEXT_ENGINE_STATIC_TOKENS_PATH=.context-engine/static-tokens.json
