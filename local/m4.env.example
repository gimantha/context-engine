# M4 local profile: provider-backed worker. Copy to engine/.env and fill in the model keys.
CONTEXT_ENGINE_DB_PATH=.context-engine/control.db
CONTEXT_ENGINE_MIGRATIONS_PATH=migrations
CONTEXT_ENGINE_LOG_LEVEL=INFO
CONTEXT_ENGINE_WORKER_POLL_SECONDS=1
CONTEXT_ENGINE_WORKER_LEASE_SECONDS=30
CONTEXT_ENGINE_WORKER_MAX_ATTEMPTS=5
CONTEXT_ENGINE_AUTH_MODE=static
CONTEXT_ENGINE_STATIC_TOKENS_PATH=.context-engine/static-tokens.json
CONTEXT_ENGINE_STAGING_PATH=.context-engine/staging
CONTEXT_ENGINE_UPLOAD_MAX_BYTES=26214400
CONTEXT_ENGINE_UPLOAD_TTL_SECONDS=86400
CONTEXT_ENGINE_UPLOAD_CONTENT_TYPES=text/plain,text/markdown,text/html,application/json,application/pdf

# "provider" makes the worker converge the knowledge backend; "none" keeps it ledger-only.
CONTEXT_ENGINE_KNOWLEDGE_BACKEND=provider
CONTEXT_ENGINE_SERVICE_PRINCIPAL_ID=context-engine-service

CONTEXT_ENGINE_TELEMETRY_ENABLED=false
CONTEXT_ENGINE_FILE_LOGGING_ENABLED=false
CONTEXT_ENGINE_QUERY_CACHE_ENABLED=false
CONTEXT_ENGINE_ACCESS_CONTROL_REQUIRED=true
CONTEXT_ENGINE_LOCAL_CONTENT_ACCESS_ENABLED=false
CONTEXT_ENGINE_REMOTE_CONTENT_ACCESS_ENABLED=false
CONTEXT_ENGINE_RAW_GRAPH_QUERY_ENABLED=false
CONTEXT_ENGINE_RELATIONAL_STORE=sqlite
CONTEXT_ENGINE_GRAPH_STORE=kuzu
CONTEXT_ENGINE_VECTOR_STORE=lancedb
CONTEXT_ENGINE_KNOWLEDGE_STORAGE_PATH=.context-engine/knowledge
CONTEXT_ENGINE_MODEL_PROVIDER=openai
CONTEXT_ENGINE_MODEL_NAME=openai/gpt-5-mini
CONTEXT_ENGINE_MODEL_API_KEY=
CONTEXT_ENGINE_EMBEDDING_PROVIDER=openai
CONTEXT_ENGINE_EMBEDDING_MODEL=openai/text-embedding-3-small
CONTEXT_ENGINE_EMBEDDING_DIMENSIONS=1536
CONTEXT_ENGINE_EMBEDDING_API_KEY=
